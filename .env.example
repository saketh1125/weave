POSTGRES_PASSWORD=replace-with-a-random-hex-password
DATABASE_URL=postgresql+asyncpg://sentra:replace-with-a-random-hex-password@localhost:5433/sentra
MISTRAL_API_KEY=
MISTRAL_API_KEY2=
SENTRA_LLM_MODEL=mistral-large-4
SENTRA_DOCUMENTATION_MODEL=mistral-large-4
SENTRA_DOCUMENTATION_MAX_RUN_CALLS=200
SENTRA_DOCUMENTATION_MAX_RUN_TOKENS=16000000
SENTRA_GH_TOKEN=
SENTRA_ACCESS_TOKEN=replace-with-at-least-32-random-characters
SENTRA_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
SENTRA_SESSION_TTL_SECONDS=3600
SENTRA_GIT_ALLOWED_HOSTS=github.com
SENTRA_REPO_MAX_FILE_BYTES=1000000
SENTRA_REPO_MAX_TOTAL_BYTES=50000000
SENTRA_REPO_MAX_FILES=10000
SENTRA_EMBED_BATCH_SIZE=8
SENTRA_SCAN_JOBS=2
SENTRA_REPO_MAX_CHUNKS=20000

# Optional server-managed connections/workflow JSON; empty keeps Mistral defaults.
# Configuration examples and security limits: docs/MODEL_CONNECTIONS.md
SENTRA_MODEL_CONNECTIONS=
SENTRA_MODEL_WORKFLOWS=
SENTRA_CUSTOM_MODEL_API_KEY=

# Optional local-only Antigravity bridge. Never expose its token to Vite/browser.
SENTRA_ANTIGRAVITY_ENABLED=false
SENTRA_AGENT_BRIDGE_URL=http://host.docker.internal:9218
SENTRA_AGENT_BRIDGE_TOKEN=
